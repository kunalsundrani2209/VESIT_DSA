import java.util.Scanner;

class BrowserHistory {
    static final int MAX = 10;
    static String[] stack = new String[MAX];
    static int top = -1;

    // Push operation
    static void push(Scanner sc) {
        if (top == MAX - 1) {
            System.out.println("History is full!");
        } else {
            System.out.print("Enter URL: ");
            String url = sc.next();

            stack[++top] = url;
            System.out.println("Page visited successfully.");
        }
    }

    // Pop operation
    static void pop() {
        if (top == -1) {
            System.out.println("No previous page available.");
        } else {
            System.out.println("Going back from: " + stack[top]);
            top--;
        }
    }

    // Peek operation
    static void peek() {
        if (top == -1) {
            System.out.println("Browser history is empty.");
        } else {
            System.out.println("Current page: " + stack[top]);
        }
    }

    // Display operation
    static void display() {
        if (top == -1) {
            System.out.println("Browser history is empty.");
        } else {
            System.out.println("\nBrowser History:");
            for (int i = top; i >= 0; i--) {
                System.out.println(stack[i]);
            }
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int choice;

        while (true) {
            System.out.println("\n--- Browser History ---");
            System.out.println("1. Push (Visit Page)");
            System.out.println("2. Pop (Back)");
            System.out.println("3. Peek (Current Page)");
            System.out.println("4. Display History");
            System.out.println("5. Exit");

            System.out.print("Enter your choice: ");
            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    push(sc);
                    break;

                case 2:
                    pop();
                    break;

                case 3:
                    peek();
                    break;

                case 4:
                    display();
                    break;

                case 5:
                    System.out.println("Exiting...");
                    sc.close();
                    return;

                default:
                    System.out.println("Invalid choice!");
            }
        }
    }
}
